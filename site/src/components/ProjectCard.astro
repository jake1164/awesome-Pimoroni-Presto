---
const { project, icon } = Astro.props;

// Outline icons shown in place of a screenshot. `grid` is the generic fallback for any category.
const iconPaths = {
  game: ['M6.5 8h11a4 4 0 0 1 3.8 5.2l-1 3.1a2 2 0 0 1-3.2 1l-2.2-1.8H9.1l-2.2 1.8a2 2 0 0 1-3.2-1l-1-3.1A4 4 0 0 1 6.5 8Z', 'M7 10v4M5 12h4M15 11h.01M18 13h.01'],
  clock: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z', 'M12 7v5l3.5 2'],
  weather: ['M7 18h10a4 4 0 0 0 .3-8 6 6 0 0 0-11.6 1.6A3.3 3.3 0 0 0 7 18Z', 'M9 21l1-2M14 21l1-2'],
  cpu: ['M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z', 'M10 10h4v4h-4Z', 'M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4'],
  code: ['m8 8-4 4 4 4M16 8l4 4-4 4M13 6l-2 12'],
  community: ['M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M3 20v-1a6 6 0 0 1 12 0v1Z', 'M16 5a3 3 0 0 1 0 6', 'M18 14a5 5 0 0 1 3 4'],
  book: ['M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5Z', 'M4 17.5A2.5 2.5 0 0 1 6.5 15H20', 'M8 7h7M8 11h7'],
  display: ['M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z', 'M9 21h6M12 17v4'],
  grid: ['M4 4h6v6H4Z', 'M14 4h6v6h-6Z', 'M4 14h6v6H4Z', 'M14 14h6v6h-6Z'],
};
const paths = iconPaths[icon] ?? iconPaths.grid;

function safeHttpUrl(value) {
  try {
    const parsed = new URL(value);
    return ['http:', 'https:'].includes(parsed.protocol) && !parsed.username && !parsed.password;
  } catch {
    return false;
  }
}
const projectUrl = safeHttpUrl(project.url) ? project.url : null;
const searchText = [project.title, project.description, project.category].join(' ').toLocaleLowerCase();
---

<li
  class="project-card"
  data-id={project.id}
  data-title={project.title}
  data-category={project.category_slug}
  data-category-name={project.category}
  data-badges={project.badges.join(',')}
  data-search={searchText}
>
  <div class="card-preview" data-category-fallback={icon}>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      {paths.map((d) => <path d={d} />)}
    </svg>
    {project.badges.length > 0 && (
      <div class="card-badges">
        {project.badges.map((badge) => <span class="project-badge">{badge}</span>)}
      </div>
    )}
  </div>
  <div class="card-content">
    <h2>{project.title}</h2>
    {project.description_parts.length > 0 && (
      <p class="card-description">
        {project.description_parts.map((part) => {
          if (!part.url) return part.text;
          return safeHttpUrl(part.url) ? <a href={part.url} target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text;
        })}
      </p>
    )}
    <div class="card-footer">
      <span class="category-label">{project.category}</span>
      {projectUrl
        ? <a class="project-link" href={projectUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.title} project`}>Visit project ↗</a>
        : <span class="project-link unavailable">Link unavailable</span>}
    </div>
  </div>
</li>
